# Copy to .env and fill in. NEVER commit .env.
# KuCoin API key must be TRADE-ONLY. No withdrawal. No transfer.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# xAI (Grok) API key — in-loop decision layer + sentiment
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# One bot per instance: Telegram allows a single getUpdates poller per token.
TELEGRAM_BOT_TOKEN_TREND=
TELEGRAM_BOT_TOKEN_RANGE=

# Optional: healthchecks.io ping URL for dead-process alerting
HEALTHCHECK_PING_URL=

# Shared secret the Grok Bot council signs strategy proposals with
COUNCIL_SECRET=change-me-to-a-long-random-string

PAPER_MODE=true
MODE=conservative
INITIAL_CAPITAL_USDT=400
LOG_LEVEL=INFO
